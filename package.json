{
  "name": "gwt-test-formatter",
  "displayName": "GWT Test Formatter",
  "description": "Copy from GWT style BDD scenarios to Playwright test format.",
  "version": "0.0.2",
  "icon": "logo.png",
  "publisher": "denidiasjr",
  "repository": {
    "url": "https://github.com/denidiasjr/gwt-test-formatter"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onLanguage:typescript",
    "onLanguage:javascript"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "GWT Test Formatter Configuration",
      "properties": {
        "gwtTestFormatter.testsFolder": {
          "type": "string",
          "default": "e2e/specs/",
          "description": "Path to the test files."
        },
        "gwtTestFormatter.markdownsFolder": {
          "type": "string",
          "default": "docs/",
          "description": "Path to the markdown files."
        },
        "gwtTestFormatter.testExtension": {
          "type": "string",
          "default": ".spec.ts",
          "description": "Extension for generated test files."
        },
        "gwtTestFormatter.markdownExtension": {
          "type": "string",
          "default": ".doc.md",
          "description": "Extension for generated markdown files."
        },
        "gwtTestFormatter.enableMarkdownLinks": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable markdown links."
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "gwt-test-formatter.generateTest",
          "when": "editor.hasSelection && editorLangId == markdown",
          "group": "navigation"
        },
        {
          "command": "gwt-test-formatter.generateMarkdown",
          "when": "editor.hasSelection && (editorLangId == typescript || editorLangId == javascript)",
          "group": "navigation"
        }
      ]
    },
    "commands": [
      {
        "command": "gwt-test-formatter.generateTest",
        "title": "GWT: Copy as Test"
      },
      {
        "command": "gwt-test-formatter.generateMarkdown",
        "title": "GWT: Copy as Markdown"
      }
    ],
    "keybindings": [
      {
        "command": "gwt-test-formatter.generateTest",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c",
        "when": "editorTextFocus && editorHasSelection && editorLangId == markdown"
      },
      {
        "command": "gwt-test-formatter.generateMarkdown",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c",
        "when": "editorTextFocus && editorHasSelection && (editorLangId == typescript || editorLangId == javascript)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.11",
    "@types/vscode": "^1.75.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "diff": "^8.0.3",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0"
  }
}
